// Jenkins declarative pipeline.
//
// LCERT_ANCHOR is a credential, held apart from the bundle on purpose.

pipeline {
  agent { docker { image 'python:3.12-slim' } }
  environment { BUNDLE = 'certs/my-bundle' }
  stages {
    stage('verify certificate') {
      steps {
        withCredentials([string(credentialsId: 'lcert-anchor', variable: 'LCERT_ANCHOR')]) {
          sh 'pip install --quiet "lcert-verify @ git+https://github.com/nickharris808/lcert-verify.git@main"'
          // Exit 4 is an ABSTENTION — no trust anchor, nothing established. It
          // fails the build, which is the point; do not add `|| true`.
          sh 'lcert-verify "$BUNDLE" "$LCERT_ANCHOR" --format junit -o report.xml'
        }
      }
      post { always { junit 'report.xml' } }
    }
  }
}
